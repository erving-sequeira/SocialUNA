<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="acceso"
            stylesheets="@../css/acceso.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.socialuna.ui.controller.ControladorFeed">

    <content>
        <VBox spacing="18" styleClass="marco">

            <!-- Encabezado -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <Label text="SocialUNA"
                       styleClass="marca"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button text="Buscar estudiantes"
                        onAction="#abrirBusqueda"/>

                <Button text="Mi perfil"
                        onAction="#abrirMiPerfil"/>

            </HBox>

            <!-- Título -->
            <VBox spacing="5">
                <Label text="Inicio"
                       styleClass="titulo"/>

                <Label text="Conecta con la comunidad universitaria."
                       wrapText="true"/>
            </VBox>

            <!-- Selección del muro -->
            <TabPane fx:id="pestañas"
                     tabClosingPolicy="UNAVAILABLE"
                     prefHeight="75">

                <tabs>

                    <Tab id="tabMuro"
                         text="Mi muro">
                        <content>
                            <Label text="Publicaciones tuyas y de tus amigos."
                                   style="-fx-padding: 12;"/>
                        </content>
                    </Tab>

                    <Tab id="tabCarrera"
                         text="Mi carrera">
                        <content>
                            <Label text="Publicaciones de tu comunidad académica."
                                   style="-fx-padding: 12;"/>
                        </content>
                    </Tab>

                    <Tab id="tabSede"
                         text="Mi sede">
                        <content>
                            <Label text="Publicaciones de tu sede universitaria."
                                   style="-fx-padding: 12;"/>
                        </content>
                    </Tab>

                </tabs>
            </TabPane>

            <!-- Crear publicación -->
            <VBox spacing="10">

                <Label text="¿Qué quieres compartir?"
                       styleClass="titulo"/>

                <TextArea fx:id="textoPublicacion"
                          promptText="Escribe algo para compartir con la comunidad..."
                          wrapText="true"
                          prefRowCount="4"
                          maxHeight="120"/>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Publicar"
                            onAction="#publicar"
                            defaultButton="true"/>
                </HBox>

            </VBox>

            <!-- Mensajes del sistema -->
            <Label fx:id="mensaje"
                   styleClass="error"
                   wrapText="true"/>

            <!-- Publicaciones -->
            <VBox spacing="12">

                <Label text="Publicaciones recientes"
                       styleClass="titulo"/>

                <VBox fx:id="contenedorPanel"
                      spacing="12"/>

            </VBox>

        </VBox>
    </content>

</ScrollPane>
