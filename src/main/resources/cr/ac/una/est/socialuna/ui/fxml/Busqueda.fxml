<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            styleClass="acceso"
            stylesheets="@../css/acceso.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.socialuna.ui.controller.ControladorAmigos"
            fx:id="vistaBusqueda">

    <content>
        <VBox alignment="CENTER" styleClass="marco">

            <VBox maxWidth="650"
                  spacing="18"
                  styleClass="tarjeta">

                <Hyperlink id="volverBusqueda" text="Volver al muro" onAction="#volver"/>

                <Label text="SocialUNA"
                       styleClass="marca"/>

                <Label text="Buscar estudiantes"
                       styleClass="titulo"/>

                <Label text="Encuentra otros estudiantes de la comunidad universitaria."/>

                <HBox spacing="10">

                    <TextField fx:id="campoBusqueda"
                               promptText="Escribe un nombre o usuario..."
                               accessibleText="Buscar estudiantes"
                               onAction="#buscarPorNombreUsuario"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Buscar"
                            id="btnBuscar"
                            onAction="#buscarPorNombreUsuario"/>

                </HBox>

                <Label text="Resultados de búsqueda"/>

                <VBox fx:id="contenedorResultados"
                      spacing="12"/>

                <Label text="Mis amigos"/>
                <VBox fx:id="contenedorAmigos" spacing="12"/>

                <Label fx:id="mensaje"
                       styleClass="error"
                       wrapText="true"/>

            </VBox>

        </VBox>
    </content>

</ScrollPane>
