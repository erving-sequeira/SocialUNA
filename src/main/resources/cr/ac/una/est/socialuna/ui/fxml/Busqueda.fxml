<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vistaBusqueda" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.una.est.socialuna.ui.controller.ControladorAmigos">
    <VBox spacing="12" styleClass="cabecera-social">
        <Label text="Buscar estudiantes" styleClass="marca"/>
        <HBox spacing="10">
            <TextField fx:id="campoBusqueda" promptText="Nombre o nombre de usuario"
                       accessibleText="Nombre o nombre de usuario" onAction="#buscarPorNombreUsuario"
                       HBox.hgrow="ALWAYS"/>
            <Button id="btnBuscar" text="Buscar" styleClass="accent" onAction="#buscarPorNombreUsuario"/>
        </HBox>
        <Label fx:id="mensaje" styleClass="error" wrapText="true"/>
    </VBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="16" styleClass="cuerpo-social">
                <VBox spacing="10">
                    <Label text="Resultados" styleClass="titulo"/>
                    <VBox fx:id="contenedorResultados" spacing="8"/>
                </VBox>
                <VBox spacing="10">
                    <Label text="Mis amigos" styleClass="titulo"/>
                    <VBox fx:id="contenedorAmigos" spacing="8"/>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
